# Custom compose sequences. Referenced by XCOMPOSEFILE in .config/hypr/lua/envs.lua,
# which must give an ABSOLUTE path — env values are not tilde-expanded, and
# "~/.XCompose" sent every toolkit looking for that name relative to its own cwd.
#
# Linux only — macOS has no compose key and ignores this file entirely
# (there, £ is Option+3 and accents are Option dead keys).
#
# Compose is tap-then-type: tap the compose key, release, then type the sequence.
# The compose key is right ctrl (`compose:rctrl` in lua/input.lua), which the
# Framework 13 has and the Air60 V2 does not — its 64-key layout spends the
# bottom right on arrows and emits no right-hand modifier at all. So on the
# Air60 there is no compose key, and £ comes from keyd's alt+3 below instead.

# Keep every default sequence ('e for é, --- for em dash, and so on).
include "%L"

# keyd emits a sequence for any UTF8 value in /etc/keyd/default.conf -- that is
# how `3 = £` in its [alt] layer produces a character no us layout has. The
# sequence is keyd's own, and is copied from line 36 of
# /usr/share/keyd/keyd.compose rather than including that whole 34k-line file:
# kitty resolved the include and Firefox did not, and one line needs no parser
# feature beyond what every toolkit already does. Without it the keystroke
# types a literal 00z, which is the symptom to recognise.
<Cancel> <0> <0> <z>           : "£"   sterling

# Memorable aliases, because "l -" for a pound sign is impossible to remember.
# These need a compose key, so they are the Framework route, not the Air60 one.
<Multi_key> <p> <p>            : "£"   sterling
<Multi_key> <g> <b> <p>        : "£"   sterling
