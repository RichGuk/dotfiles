#!/bin/bash
# Push slowly-changing laptop config + install manifests to atlantis.
# Installed as a user LaunchAgent: io.grundy.mbp-push
#
# Documents/Pictures/Dev are Syncthing's job. This covers the things that
# only exist here: ssh config, shell history, macOS prefs/fonts, and a
# record of what was installed. /data/WorkMBP is picked up by atlantis's
# nightly restic run, which is where versioning comes from.

set -u

DEST_HOST=atlantis.lan
DEST="rich@${DEST_HOST}:/data/WorkMBP/macbook"
BREW=/opt/homebrew
RSYNC=$BREW/bin/rsync                     # NOT /usr/bin/rsync: that's openrsync on 15+
NOTIFIER=$BREW/bin/terminal-notifier
LOG=$HOME/Library/Logs/mbp-push.log
SNAP_MAX_MIN=180

mkdir -p "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date -Iseconds)" "$*" >>"$LOG"; }

notify() {
  [ -x "$NOTIFIER" ] || return 0
  "$NOTIFIER" -title "MacBook backup" -message "$1" \
    -group mbp-push -sound Basso -execute "open $LOG" >/dev/null 2>&1 || true
}

# --- Not on the home network is not a failure. Silent, exit 0.
if ! /usr/bin/nc -z -w2 "$DEST_HOST" 22 >/dev/null 2>&1; then
  log "SKIP ${DEST_HOST}:22 unreachable"
  exit 0
fi

# --- Cross-check the snapshot daemon. A job that isn't running can't report
#     itself, and this is the only thing positioned to notice.
newest=$(/usr/bin/tmutil listlocalsnapshots / 2>/dev/null \
         | grep 'com\.apple\.TimeMachine\.' \
         | sed 's/.*TimeMachine\.//; s/\..*$//' \
         | sort | tail -1)
if [ -z "$newest" ]; then
  log "WARN no local snapshots at all"
  notify "No local APFS snapshots -- is io.grundy.macbook-local-snapshot loaded?"
else
  ts=$(date -j -f '%Y-%m-%d-%H%M%S' "$newest" +%s 2>/dev/null || echo 0)
  if [ "$ts" -gt 0 ]; then
    age=$(( ( $(date +%s) - ts ) / 60 ))
    if [ "$age" -gt "$SNAP_MAX_MIN" ]; then
      log "WARN newest snapshot ${age}m old"
      notify "No local snapshot for ${age}m -- is io.grundy.macbook-local-snapshot loaded?"
    fi
  fi
fi

# --- Manifests, built in a temp dir so a failed dump can't overwrite a good
#     Brewfile at the destination with a truncated one.
TMP=$(mktemp -d) || { log "FAIL mktemp"; notify "Push failed: mktemp"; exit 1; }
trap 'rm -rf "$TMP"' EXIT

"$BREW/bin/brew" bundle dump --force --file="$TMP/Brewfile" >>"$LOG" 2>&1 \
  || log "WARN brew bundle dump failed"
if [ -x "$BREW/bin/mas" ]; then
  "$BREW/bin/mas" list >"$TMP/mas-apps.txt" 2>>"$LOG" || log "WARN mas list failed"
fi
/bin/ls -1 /Applications >"$TMP/applications.txt" 2>>"$LOG"
/usr/bin/tmutil listlocalsnapshots / >"$TMP/local-snapshots.txt" 2>/dev/null

# --- Push. --delete is safe here: everything below is reproducible config,
#     and atlantis's restic run keeps 14 daily / 8 weekly / 12 monthly of it.
#     Never add --delete to the photo/originals rsyncs.
rc=0
push() { "$RSYNC" -a --delete "$1" "$2" >>"$LOG" 2>&1 || rc=1; }

push "$TMP/"                       "$DEST/manifests/"
push "$HOME/.ssh/"                 "$DEST/ssh/"
push "$HOME/Library/Preferences/"  "$DEST/macos/Preferences/"
push "$HOME/Library/Fonts/"        "$DEST/macos/Fonts/"

# Single file, so no directory to mirror and no --delete. NOTE the real
# HISTFILE is set in ~/.config/zsh/00_history.zsh -- it is NOT ~/.zsh_history,
# which is a stale relic from 2023.
"$RSYNC" -a "$HOME/.cache/zsh/history" "$DEST/shell/" >>"$LOG" 2>&1 || rc=1

if [ "$rc" -ne 0 ]; then
  log "FAIL rsync (${DEST_HOST} was reachable, so this is real)"
  notify "Push to atlantis FAILED -- see log"
  exit 1
fi

log "OK"
