#!/usr/bin/env bash
# Create a zeneducate worktree with an isolated dev env, then open it in herdr.
#
#   zen-worktree <branch> [--from <base>] [--repo <path>] [--no-shared-gems]
#
# Ports are offset-based: API 3000+n (published), web 8080+n. Everything else
# stays on the docker network — web reaches the API via Vite's /dev-api proxy.
# Gems are shared with the main checkout unless --no-shared-gems.

set -euo pipefail

REPO="${HOME}/Dev/Work/zeneducate"
WORKTREE_ROOT="${HOME}/Dev/Work/zeneducate-worktrees"
OVERRIDE_SRC="${HOME}/Scripts/setup/zeneducate/docker-compose.override.yml"
FROM_BASE=""
BRANCH=""
SHARED_GEMS=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --from) FROM_BASE="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        --no-shared-gems) SHARED_GEMS=false; shift ;;
        -h | --help)
            sed -n '2,8p' "$0" | sed -e 's/^# //' -e 's/^#$//'
            exit 0
            ;;
        -*) echo "unknown flag: $1" >&2; exit 1 ;;
        *) BRANCH="$1"; shift ;;
    esac
done

[[ -n $BRANCH ]] || { echo "usage: zen-worktree <branch> [--from <base>]" >&2; exit 1; }
[[ -d $REPO/.git ]] || { echo "not a git repo: $REPO" >&2; exit 1; }
[[ -f $OVERRIDE_SRC ]] || { echo "missing override template: $OVERRIDE_SRC" >&2; exit 1; }

SLUG=$(printf '%s' "$BRANCH" | tr '/' '-' | tr -cd '[:alnum:]-_' | tr '[:upper:]' '[:lower:]')
DB_SLUG=$(printf '%s' "$SLUG" | tr '-' '_')
WORKTREE="$WORKTREE_ROOT/$SLUG"

[[ -e $WORKTREE ]] && { echo "worktree already exists: $WORKTREE" >&2; exit 1; }

# Offset is derived, not stored, so removing a worktree frees its number.
# Sibling checkouts are scanned too — hand-made worktrees live beside the repo.
claimed_ports=" "
for env_file in "$WORKTREE_ROOT"/*/api/.env "$(dirname "$REPO")"/*/api/.env; do
    [[ -f $env_file ]] || continue
    port=$(sed -n 's/^API_PORT=//p' "$env_file" | head -1)
    [[ -n $port ]] && claimed_ports+="$port "
done

port_taken() {
    local p=$1
    [[ $claimed_ports == *" $p "* ]] && return 0
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -qE "[:.]${p}[[:space:]]" && return 0
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && return 0
    fi
    return 1
}

offset=1
while port_taken $((3000 + offset)); do ((offset++)); done

API_PORT=$((3000 + offset))
WEB_PORT=$((8080 + offset))

HOSTNAME_SHORT=$(hostname -s 2>/dev/null || hostname)
ALLOWED_HOSTS="localhost,${HOSTNAME_SHORT},${HOSTNAME_SHORT}.lan"

set_env_var() {
    local file=$1 key=$2 value=$3
    touch "$file"
    if grep -q "^${key}=" "$file"; then
        sed -i.bak "s|^${key}=.*|${key}=${value}|" "$file" && rm -f "${file}.bak"
    else
        printf '%s=%s\n' "$key" "$value" >>"$file"
    fi
}

echo "worktree : $WORKTREE"
echo "branch   : $BRANCH  (offset $offset)"
echo "api      : $API_PORT   web: $WEB_PORT"

mkdir -p "$WORKTREE_ROOT"

if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$REPO" worktree add "$WORKTREE" "$BRANCH"
elif git -C "$REPO" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git -C "$REPO" worktree add --track -b "$BRANCH" "$WORKTREE" "origin/$BRANCH"
elif [[ -n $FROM_BASE ]]; then
    git -C "$REPO" worktree add "$WORKTREE" -b "$BRANCH" "$FROM_BASE"
else
    git -C "$REPO" worktree add "$WORKTREE" -b "$BRANCH"
fi

if command -v mise >/dev/null 2>&1; then
    mise trust --all --cd "$WORKTREE" >/dev/null
fi

# --- env files ---
for dir in api web; do
    [[ -d $REPO/$dir ]] || continue
    mkdir -p "$WORKTREE/$dir"
    for env_file in "$REPO/$dir"/.env*; do
        [[ -f $env_file ]] || continue
        case "$env_file" in *.example | *.sample) continue ;; esac
        cp -p "$env_file" "$WORKTREE/$dir/$(basename "$env_file")"
    done
done

# --- api ---
set_env_var "$WORKTREE/api/.env" API_PORT "$API_PORT"
set_env_var "$WORKTREE/api/.env" COMPOSE_PROJECT_NAME "zen_${DB_SLUG}"
set_env_var "$WORKTREE/api/.env" ALLOWED_HOSTS "$ALLOWED_HOSTS"

cp "$OVERRIDE_SRC" "$WORKTREE/api/docker-compose.override.yml"

if [[ $SHARED_GEMS == true ]]; then
    main_project=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$REPO/api/.env" 2>/dev/null | head -1)
    main_project=${main_project:-$(basename "$REPO")}
    shared_volume="${main_project}_bundle_path"

    if docker volume inspect "$shared_volume" >/dev/null 2>&1; then
        cat >>"$WORKTREE/api/docker-compose.override.yml" <<EOF

# Delete this block for a private gem volume.
volumes:
  bundle_path:
    external: true
    name: ${shared_volume}
EOF
        echo "gems     : shared from ${shared_volume}"
    else
        echo "gems     : ${shared_volume} not found — using a private volume"
    fi
else
    echo "gems     : private volume (--no-shared-gems)"
fi

# --- web ---
mkdir -p "$WORKTREE/web"

if [[ -d $REPO/web/node_modules && ! -e $WORKTREE/web/node_modules ]]; then
    if cmp -s "$REPO/web/package-lock.json" "$WORKTREE/web/package-lock.json"; then
        ln -s "$REPO/web/node_modules" "$WORKTREE/web/node_modules"
        echo "modules  : symlinked from main (lockfiles match)"
    else
        echo "modules  : lockfile differs — run 'npm ci' in $WORKTREE/web"
    fi
fi

set_env_var "$WORKTREE/web/.env.local" PORT "$WEB_PORT"
set_env_var "$WORKTREE/web/.env.local" API_HOST "http://localhost:${API_PORT}"
set_env_var "$WORKTREE/web/.env.local" ALLOWED_HOSTS "$ALLOWED_HOSTS"

echo
echo "  http://${HOSTNAME_SHORT}:${WEB_PORT}"
echo "  cd $WORKTREE/api && bin/dc up"
echo

exec herdr-sessionizer "$WORKTREE"
