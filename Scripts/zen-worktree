#!/usr/bin/env bash
# Create a zeneducate worktree with an isolated dev env, then open it in herdr.
#
#   zen-worktree <branch> [--from <base>] [--repo <path>] [--no-shared-gems]
#
# Ports are offset-based: API 3000+n (published), web 8080+n. Everything else
# stays on the docker network — web reaches the API via Vite's /dev-api proxy.
# Gems are shared with the main checkout unless --no-shared-gems.

set -euo pipefail

# A non-login shell can have a bare PATH, and then devbox-route, mise and hc
# all silently go missing.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$SCRIPT_DIR:$HOME/.local/bin:$PATH"

REPO="${HOME}/Dev/Work/zeneducate"
WORKTREE_ROOT="${HOME}/Dev/Work/zeneducate-worktrees"
OVERRIDE_SRC="${HOME}/Scripts/setup/zeneducate/docker-compose.override.yml"
FROM_BASE=""
BRANCH=""
SHARED_GEMS=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --from) FROM_BASE="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        --no-shared-gems) SHARED_GEMS=false; shift ;;
        -h | --help)
            sed -n '2,8p' "$0" | sed -e 's/^# //' -e 's/^#$//'
            exit 0
            ;;
        -*) echo "unknown flag: $1" >&2; exit 1 ;;
        *) BRANCH="$1"; shift ;;
    esac
done

[[ -n $BRANCH ]] || { echo "usage: zen-worktree <branch> [--from <base>]" >&2; exit 1; }
[[ -d $REPO/.git ]] || { echo "not a git repo: $REPO" >&2; exit 1; }
[[ -f $OVERRIDE_SRC ]] || { echo "missing override template: $OVERRIDE_SRC" >&2; exit 1; }

SLUG=$(printf '%s' "$BRANCH" | tr '/' '-' | tr -cd '[:alnum:]-_' | tr '[:upper:]' '[:lower:]')
DB_SLUG=$(printf '%s' "$SLUG" | tr '-' '_')
WORKTREE="$WORKTREE_ROOT/$SLUG"

# Both files are gitignored, so `worktree add` leaves them out and a new tree
# starts with no personal permissions and, worse, a CLAUDE.md whose
# @AGENTS.local.md import resolves to nothing. Copied again on every switch
# because the originals keep gaining rules, and a tree created weeks ago is
# otherwise still working from whatever they said that day.
copy_agent_config() {
    local local_file
    for local_file in .claude/settings.local.json AGENTS.local.md; do
        [[ -f $REPO/$local_file ]] || continue
        mkdir -p "$(dirname "$WORKTREE/$local_file")"
        cp -p "$REPO/$local_file" "$WORKTREE/$local_file"
        echo "agent    : $local_file copied"
    done
}

# --- herdr ---
# herdr-core has no spaces or tabs of its own. The Mac's herdr-app turns any
# terminal labelled herdr.space=<id> / herdr.tab=<id> into a space on this
# machine, tags a space whose ID starts with "zen" as Work, and closes a space
# once its last terminal ends. IDs are [a-z0-9] only; dashes are untested there.
# Tabs cannot be named or split from here, so each terminal also carries
# zen.tab (its tab's name) and zen.pane (top/bottom) for the Mac side to apply.
SPACE_ID="zen$(printf '%s' "$SLUG" | tr -cd '[:alnum:]')"
SH="${SHELL:-zsh}"

herdr_ok() { command -v hc >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; }

space_open() {
    [[ -n $(hc ls --json --label "herdr.space=$SPACE_ID" 2>/dev/null |
        jq -r '.terminals[]?.address' | head -1) ]]
}

# --no-parent so the terminals neither die with this script nor type notes
# into whatever terminal ran it.
#   space_term <tab> <pane> [key=value ...] -- <cmd...>
space_term() {
    local tab=$1 pane=$2 extra=()
    shift 2
    while [[ $# -gt 0 && $1 != -- ]]; do
        extra+=(--label "$1")
        shift
    done
    shift
    hc run --json --bg --no-parent --keep --cwd "$WORKTREE" \
        --label "herdr.space=$SPACE_ID" --label "herdr.tab=${SPACE_ID}$(tr '[:upper:]' '[:lower:]' <<<"$tab")" \
        --label "zen.tab=$tab" --label "zen.pane=$pane" "${extra[@]}" \
        -- "$@" 2>/dev/null | jq -r '.address // empty'
}
# Run a command, then fall back to an interactive shell when it exits, rather
# than closing the pane.
then_shell() { printf '%s; exec %s -i' "$1" "$SH"; }

# Type text at a shell's prompt without pressing enter, once the prompt is up.
type_into() {
    local t=$1 text=$2 keys=() i c
    for _ in {1..25}; do
        [[ -n $(hc read "$t" 2>/dev/null | tr -d '[:space:]') ]] && break
        sleep 0.2
    done
    for ((i = 0; i < ${#text}; i++)); do
        c=${text:i:1}
        [[ $c == " " ]] && c=space
        keys+=("$c")
    done
    hc keys "$t" "${keys[@]}" >/dev/null 2>&1
}

# Servers gets a shell with `dc up` typed but not run, plus a second pane with
# the URLs. The editor and agent each start in their own tab.
open_space() {
    herdr_ok || { echo "herdr    : hc or jq missing — no space opened" >&2; return 0; }
    if space_open; then
        echo "herdr    : space $SPACE_ID already open"
        return 0
    fi

    local lines=("") top
    if [[ -n ${PROXY_HOST:-} ]]; then
        lines+=("  http://${PROXY_HOST}" "  http://${PROXY_HOST}/_devbox/mail"
            "  http://${PROXY_HOST}/monitoring/sidekiq")
    fi
    lines+=("  http://${HOSTNAME_SHORT}:${WEB_PORT}" "  api :${API_PORT}    web :${WEB_PORT}"
        "" "  mise run dc up" "  mise run web:dev" "")

    # The Mac's sidebar mod does the rest the first time it sees the space:
    # renames tabs from zen.tab, orders them Servers, Editor, Terminal, Agent,
    # and splits the Servers pane downward to run zen.below (with sh -c, in the
    # worktree) in the new bottom pane. Starting a bottom terminal here instead
    # would stop that split and leave the panes side by side.
    top=$(space_term Servers top \
        "zen.below=$(then_shell "clear; printf '%s\n' $(printf '%q ' "${lines[@]}")")" \
        -- "$SH" -i)
    space_term Editor main -- "$SH" -ic "$(then_shell 'nvim .')" >/dev/null
    space_term Terminal main -- "$SH" -i >/dev/null
    space_term Agent main -- "$SH" -ic "$(then_shell claude)" >/dev/null
    [[ -n $top ]] && type_into "$top" 'mise run dc up'

    echo "herdr    : space $SPACE_ID opened (tagged Work)"
}

# Switching to an existing worktree otherwise leaves it exactly as it was — no
# env rewrite, no port reshuffle, no relaunching an editor over the one already
# running. Its space is reopened only if every terminal in it has gone.
if [[ -e $WORKTREE ]]; then
    echo "worktree : $WORKTREE (existing — switching)"
    copy_agent_config
    API_PORT=$(sed -n 's/^API_PORT=//p' "$WORKTREE/api/.env" 2>/dev/null | head -1)
    WEB_PORT=$(sed -n 's/^PORT=//p' "$WORKTREE/web/.env.local" 2>/dev/null | head -1)
    PROXY_SLUG=$(sed -n 's/^PROXY_SLUG=//p' "$WORKTREE/api/.env" 2>/dev/null | head -1)
    PROXY_HOST=${PROXY_SLUG:+${PROXY_SLUG}.zen.internal}
    HOSTNAME_SHORT=$(hostname -s 2>/dev/null || hostname)
    open_space
    exit 0
fi

# Offset is derived, not stored, so removing a worktree frees its number.
# Sibling checkouts are scanned too — hand-made worktrees live beside the repo.
claimed_ports=" "
for env_file in "$WORKTREE_ROOT"/*/api/.env "$(dirname "$REPO")"/*/api/.env; do
    [[ -f $env_file ]] || continue
    port=$(sed -n 's/^API_PORT=//p' "$env_file" | head -1)
    [[ -n $port ]] && claimed_ports+="$port "
done

port_taken() {
    local p=$1
    [[ $claimed_ports == *" $p "* ]] && return 0
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -qE "[:.]${p}[[:space:]]" && return 0
    elif command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && return 0
    fi
    return 1
}

offset=1
while port_taken $((3000 + offset)); do ((offset++)); done

API_PORT=$((3000 + offset))
WEB_PORT=$((8080 + offset))

HOSTNAME_SHORT=$(hostname -s 2>/dev/null || hostname)
ALLOWED_HOSTS="localhost,${HOSTNAME_SHORT},${HOSTNAME_SHORT}.lan,.internal"
hash_branch() {
    if command -v sha1sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha1sum | cut -c1-8
    else
        printf '%s' "$1" | shasum | cut -c1-8
    fi
}

proxy_slug_taken() {
    local env_file
    for env_file in "$WORKTREE_ROOT"/*/api/.env "$(dirname "$REPO")"/*/api/.env; do
        [[ -f $env_file ]] && grep -qx "PROXY_SLUG=$1" "$env_file" && return 0
    done
    return 1
}

# A ticket can have several branches, so only the first worktree for it gets
# the bare ticket; later ones keep it readable with a short hash on the end.
proxy_slug_for() {
    local ticket
    ticket=$(printf '%s' "$1" | grep -oiE 'sc-[0-9]+' | head -1 | tr '[:upper:]' '[:lower:]')
    if [[ -z $ticket ]]; then
        hash_branch "$1"
    elif proxy_slug_taken "$ticket"; then
        printf '%s-%s' "$ticket" "$(hash_branch "$1" | cut -c1-4)"
    else
        printf '%s' "$ticket"
    fi
}

PROXY_SLUG=$(proxy_slug_for "$BRANCH")
PROXY_HOST="${PROXY_SLUG}.zen.internal"

set_env_var() {
    local file=$1 key=$2 value=$3
    touch "$file"
    if grep -q "^${key}=" "$file"; then
        sed -i.bak "s|^${key}=.*|${key}=${value}|" "$file" && rm -f "${file}.bak"
    else
        printf '%s=%s\n' "$key" "$value" >>"$file"
    fi
}

echo "worktree : $WORKTREE"
echo "branch   : $BRANCH  (offset $offset)"
echo "api      : $API_PORT   web: $WEB_PORT"

mkdir -p "$WORKTREE_ROOT"

if [[ -n $FROM_BASE ]]; then
    git -C "$REPO" rev-parse --verify --quiet "$FROM_BASE^{commit}" >/dev/null ||
        { echo "unknown base: $FROM_BASE" >&2; exit 1; }
    if git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
        echo "branch $BRANCH already exists — drop --from to use it, or delete it first" >&2
        exit 1
    fi
    git -C "$REPO" worktree add "$WORKTREE" -b "$BRANCH" "$FROM_BASE"
elif git -C "$REPO" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    git -C "$REPO" worktree add "$WORKTREE" "$BRANCH"
elif git -C "$REPO" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    git -C "$REPO" worktree add --track -b "$BRANCH" "$WORKTREE" "origin/$BRANCH"
else
    git -C "$REPO" worktree add "$WORKTREE" -b "$BRANCH"
fi

if command -v mise >/dev/null 2>&1; then
    mise trust --all --cd "$WORKTREE" >/dev/null
fi

# --- env files ---
for dir in api web; do
    [[ -d $REPO/$dir ]] || continue
    mkdir -p "$WORKTREE/$dir"
    for env_file in "$REPO/$dir"/.env*; do
        [[ -f $env_file ]] || continue
        case "$env_file" in *.example | *.sample) continue ;; esac
        cp -p "$env_file" "$WORKTREE/$dir/$(basename "$env_file")"
    done
done

# --- agent config ---
copy_agent_config

# --- api ---
set_env_var "$WORKTREE/api/.env" API_PORT "$API_PORT"
set_env_var "$WORKTREE/api/.env" COMPOSE_PROJECT_NAME "zen_${DB_SLUG}"
set_env_var "$WORKTREE/api/.env" ALLOWED_HOSTS "$ALLOWED_HOSTS"

# The override gives mailpit the network alias mail-$PROXY_SLUG, which is what
# the proxy routes to. A compose project name is far past the 63-character DNS
# label limit, so the container's own name is not addressable.
set_env_var "$WORKTREE/api/.env" PROXY_SLUG "$PROXY_SLUG"

cp "$OVERRIDE_SRC" "$WORKTREE/api/docker-compose.override.yml"

if [[ $SHARED_GEMS == true ]]; then
    main_project=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$REPO/api/.env" 2>/dev/null | head -1)
    main_project=${main_project:-$(basename "$REPO")}
    shared_volume="${main_project}_bundle_path"

    if docker volume inspect "$shared_volume" >/dev/null 2>&1; then
        cat >>"$WORKTREE/api/docker-compose.override.yml" <<EOF

# Delete this block for a private gem volume.
volumes:
  bundle_path:
    external: true
    name: ${shared_volume}
EOF
        echo "gems     : shared from ${shared_volume}"
    else
        echo "gems     : ${shared_volume} not found — using a private volume"
    fi
else
    echo "gems     : private volume (--no-shared-gems)"
fi

# --- web ---
mkdir -p "$WORKTREE/web"

# A symlink resolves to a path outside the worktree, which Vite's
# server.fs.allow rejects. A copy-on-write clone is a real directory inside it
# and costs almost nothing: btrfs reflink, or clonefile on APFS.
clone_dir() {
    local src=$1 dst=$2
    cp -a --reflink=always "$src" "$dst" 2>/dev/null && return 0
    rm -rf "$dst"
    cp -ac "$src" "$dst" 2>/dev/null && return 0
    rm -rf "$dst"
    return 1
}

if [[ -d $REPO/web/node_modules && ! -e $WORKTREE/web/node_modules ]]; then
    if cmp -s "$REPO/web/package-lock.json" "$WORKTREE/web/package-lock.json"; then
        if clone_dir "$REPO/web/node_modules" "$WORKTREE/web/node_modules"; then
            echo "modules  : cloned from main (copy-on-write)"
        else
            echo "modules  : no CoW support here — run 'npm ci' in $WORKTREE/web"
        fi
    else
        echo "modules  : lockfile differs — run 'npm ci' in $WORKTREE/web"
    fi
fi

set_env_var "$WORKTREE/web/.env.local" PORT "$WEB_PORT"
set_env_var "$WORKTREE/web/.env.local" API_HOST "http://localhost:${API_PORT}"
set_env_var "$WORKTREE/web/.env.local" ALLOWED_HOSTS "$ALLOWED_HOSTS"

# --- proxy ---
# Registration failing is not fatal, but the URL must not be advertised as
# working when it is not — that lands as a confusing 404 much later.
PROXY_READY=false
if ! command -v devbox-route >/dev/null 2>&1; then
    echo "proxy    : devbox-route NOT ON PATH — no route registered" >&2
else
    # api/docker-compose.override.yml declares this network as external, so the
    # worktree will not start at all until it exists. It normally does, since
    # the proxy creates it, but a box where the proxy has never run would fail
    # here with a message pointing at compose rather than at the proxy.
    docker network inspect devbox >/dev/null 2>&1 ||
        docker network create devbox >/dev/null 2>&1 ||
        echo "proxy    : could not create the devbox network — mailpit will not route" >&2

    # /monitoring goes straight to Rails rather than through Vite. Sidekiq Web
    # writes root-absolute links (/monitoring/sidekiq/busy), so it only works at
    # the path it is actually mounted on — Vite's /dev-api prefix would be lost
    # from every link and asset on the page.
    if devbox-route add "$PROXY_SLUG" "$WEB_PORT" \
        --host "$PROXY_HOST" --label "$BRANCH" \
        --path "/_devbox/mail=mail-${PROXY_SLUG}:8025" \
        --path "/monitoring=host.docker.internal:${API_PORT}" >/dev/null; then
        PROXY_READY=true
        echo "proxy    : http://${PROXY_HOST}"
        echo "mail     : http://${PROXY_HOST}/_devbox/mail"
        echo "sidekiq  : http://${PROXY_HOST}/monitoring/sidekiq"
    else
        echo "proxy    : FAILED to register ${PROXY_HOST}" >&2
    fi
fi

# Active Storage builds direct-upload and redirect URLs from api/.env's API_HOST,
# and the browser has to be able to reach them — so it must be the proxy host plus
# Vite's /dev-api prefix, not the port the API happens to listen on. Rails passes
# the value through untouched as long as it carries no port, hence no :$API_PORT.
if [[ $PROXY_READY == true ]]; then
    set_env_var "$WORKTREE/api/.env" API_HOST "${PROXY_HOST}/dev-api"
else
    set_env_var "$WORKTREE/api/.env" API_HOST "localhost:${API_PORT}"
fi

echo
if [[ $PROXY_READY == true ]]; then
    echo "  http://${PROXY_HOST}"
    echo "  http://${PROXY_HOST}/_devbox/mail"
    echo "  http://${PROXY_HOST}/monitoring/sidekiq"
fi
echo "  http://${HOSTNAME_SHORT}:${WEB_PORT}"
echo "  mise run dc up      (from $WORKTREE)"
echo "  mise run web:dev"
echo

[[ $PROXY_READY == true ]] || PROXY_HOST=""
open_space

exit 0
