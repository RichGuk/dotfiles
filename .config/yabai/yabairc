# SA-only — dead once SIP is enabled. Delete this block, and every other
# "SA-only" marked line below, after SIP has been on for good.
#yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
#sudo yabai --load-sa

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config top_padding 2
yabai -m config bottom_padding 2
yabai -m config left_padding 2
yabai -m config right_padding 2
yabai -m config window_gap 10
# SA-only — accepted but never applied, so tiled windows keep their shadows.
#yabai -m config window_shadow float
yabai -m config external_bar main:30:0

yabai -m config window_opacity off

yabai -m config split_ratio 0.5

yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_follows_focus off

# `.[0].id` yields null on an empty space, which used to spam
# "value 'null' is not a valid option for WINDOW_SEL" on every switch.
yabai -m signal --add event=space_changed action='id=$(yabai -m query --windows --space | jq -r ".[0].id // empty"); [ -n "$id" ] && yabai -m window --focus "$id"'

yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
yabai -m signal --add event=space_changed action="sketchybar --trigger space_changed"

yabai -m rule --add app="^(DisplayCAL|LuLu|Calculator|Software Update|Dictionary|VLC|System Preferences|System Settings|zoom.us|Photo Booth|Archive Utility|App Store|Steam|Raycast|Activity Monitor|Finder|krisp|Shottr|Browserosaurus)$" manage=off
# SA-only — sub-layer was the whole point of this rule; without it these three
# are already covered by the manage=off list above.
#yabai -m rule --add label="float-above" app="^(Finder|Calculator|Shottr)$" manage=off sub-layer=above

yabai -m rule --add label="Firefox" app="^Firefox$" title="^(Library)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off


n=$(yabai -m query --spaces --space | jq '.windows | length')
if [ $n = 1 ]; then
    borders active_color=0x00000000 inactive_color=0x00000000 width=3.0 blacklist="Finder,System Settings,VLC,Loom,Todoist" &
else
    borders active_color=0xffcba6f7 inactive_color=0xff1e1e2e width=3.0 blacklist="Finder,System Settings,VLC,Loom,Todoist" &
fi

yabai -m signal --add event=window_focused action="$HOME/.config/yabai/update_border_color.sh"

# Corrects external_bar above when the main display is notched. Backgrounded
# because the osascript call is slow and would otherwise delay yabai starting.
( sleep 3; "$HOME/.config/sketchybar/plugins/notch.sh" ) >/dev/null 2>&1 &
