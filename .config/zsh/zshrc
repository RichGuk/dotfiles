# Dedupe on re-source: nested shells and `source ~/.zshrc` would otherwise stack
# copies. Note -U only applies to *array* assignments, so build $path, not $PATH.
typeset -U path fpath

path=(
  # thoughtbot's .git/safe trick: a repo's bin/ and node_modules/.bin land on
  # PATH only after `git trust` (which is just `mkdir -p .git/safe`). Safe
  # despite being relative, because .git is created by clone and can never be
  # shipped inside a repo -- only you can mark one trusted. First in the list
  # so project binstubs shadow system ones. Only applies at the repo root.
  .git/safe/../../bin
  .git/safe/../../node_modules/.bin
  $HOME/Scripts
  $HOME/.spicetify
  $HOME/.local/bin
  /usr/local/bin
  /opt/homebrew/bin
  $HOME/.cargo/bin
  $path
)
export PATH
[[ ":$TERMINFO_DIRS:" == *":$HOME/.local/share/terminfo:"* ]] ||
  export TERMINFO_DIRS=$TERMINFO_DIRS:$HOME/.local/share/terminfo
export EDITOR=nvim
export DEFAULT_USER=$USERNAME

for config_file ($HOME/.config/zsh/*.zsh) source $config_file
unset config_file

eval "$(mise activate zsh)"
eval "$(mise completion zsh)"

# Which agent to talk to is decided in .zshenv and nothing here revises it.
# This machine holds its own key and runs its own socket-activated agent, so
# there is no forwarded socket to chase and no symlink to keep fresh. Agent
# forwarding OUT of here, to Roci and Atlantis, is unaffected: that forwards
# whatever $SSH_AUTH_SOCK names, which is this machine's agent.

# A herdr session outlives the connection that started it, so panes keep stale
# SSH_* vars. They name a client and port, so ask sshd if it still exists.
#
# The WAYLAND_DISPLAY half is gated on that: a genuinely remote session would
# otherwise get THIS machine's clipboard rather than the laptop's.
#
# On precmd as well as at startup, so walking to the machine and starting
# something in a pane that is already open just works. The guard keeps it to
# one `ss` call in the only state that needs fixing.
_fix_session_env() {
  [[ -n $SSH_CONNECTION ]] || return 0

  local peer="${${(s: :)SSH_CONNECTION}[1]}:${${(s: :)SSH_CONNECTION}[2]}"
  ss -tnH state established 'sport = :22' 2>/dev/null | grep -q "$peer" && return 0

  unset SSH_CONNECTION SSH_CLIENT SSH_TTY

  if [[ -z $WAYLAND_DISPLAY ]]; then
    local wl=(${XDG_RUNTIME_DIR:-/run/user/$UID}/wayland-[0-9]*(N))
    [[ -n ${wl[1]} ]] && export WAYLAND_DISPLAY=${wl[1]:t}
  fi
  return 0
}

_fix_session_env
autoload -Uz add-zsh-hook
add-zsh-hook precmd _fix_session_env

export GPG_TTY=$TTY

(( $+commands[atuin] )) && eval "$(atuin init zsh)"

# Local zsh settings.
[[ -s "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

path=($path) # re-apply -U over any scalar PATH= appends made above
