pragma Singleton

// Monitors and their scaling. Reads via Quickshell's Hyprland IPC; writes via
// `hyprctl eval` (Hyprland.dispatch cannot set a monitor, and `hyprctl keyword`
// refuses a Lua config). Only valid scales are offered: Hyprland silently
// ignores a scale k/120 unless k divides gcd(w*120, h*120).

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

Singleton {
    id: root

    readonly property var monitors: Hyprland.monitors.values

    // The focused monitor, falling back to the first so the control is never dead.
    readonly property var focusedMonitor: {
        for (const m of monitors) {
            if (m.focused) return m;
        }
        return monitors.length ? monitors[0] : null;
    }

    readonly property var candidateScales: [1, 1.25, 1.5, 1.6, 1.75, 2, 2.5, 3]

    function gcd(a, b) {
        while (b) { const t = a % b; a = b; b = t; }
        return a;
    }

    function validScales(width, height) {
        if (!width || !height) return [1];
        const g = root.gcd(width * 120, height * 120);
        const out = [];
        for (const s of root.candidateScales) {
            const k = Math.round(s * 120);
            if (g % k === 0) out.push(s);
        }
        // Always offer something, even for an odd mode.
        return out.length ? out : [1];
    }

    // Refresh rate is only on the raw IPC object.
    function refreshRate(monitor) {
        if (!monitor || !monitor.lastIpcObject) return 0;
        return Math.round(monitor.lastIpcObject.refreshRate || 0);
    }

    function logicalSize(monitor) {
        if (!monitor || !monitor.scale) return "";
        return Math.round(monitor.width / monitor.scale) + "x"
             + Math.round(monitor.height / monitor.scale);
    }

    // ------------------------------------------------------------------
    // Applying a scale
    // ------------------------------------------------------------------
    Process { id: applyProc }

    function setScale(monitor, scale) {
        if (!monitor) return;

        // The name is interpolated into Lua source; a headless output can be
        // created with an arbitrary name.
        if (!/^[A-Za-z0-9._-]+$/.test(monitor.name)) {
            console.warn("Display: refusing unsafe monitor name: " + monitor.name);
            return;
        }

        // Mode and position stay as they were.
        applyProc.command = [
            "hyprctl", "eval",
            'hl.monitor({ output = "' + monitor.name + '"'
                + ', mode = "preferred", position = "auto"'
                + ', scale = ' + scale + ' })'
        ];
        applyProc.running = true;

        root.remember(monitor.name, scale);
    }

    // ------------------------------------------------------------------
    // Persistence. A runtime eval does not survive a restart, so choices are
    // written as a Lua table that config/hypr/lua/monitors.lua dofile()s.
    // Lua, not JSON: Lua has no JSON parser in its standard library.
    // ------------------------------------------------------------------
    readonly property string statePath:
        (Quickshell.env("XDG_STATE_HOME")
         || Quickshell.env("HOME") + "/.local/state")
        + "/hyprland-shell/monitors.lua"

    // Mirrors what has been written, so the file can be regenerated whole.
    property var overrides: ({})

    FileView {
        id: stateFile
        path: root.statePath
        atomicWrites: true
        printErrors: false
    }

    function remember(name, scale) {
        const next = {};
        for (const k in root.overrides) next[k] = root.overrides[k];
        next[name] = scale;
        root.overrides = next;

        let lua = "-- Generated by the Quickshell display module. Edited here,\n"
                + "-- overwritten there: change scale from the bar popout.\n"
                + "return {\n";
        for (const k in next) {
            lua += '    ["' + k + '"] = { scale = ' + next[k] + " },\n";
        }
        lua += "}\n";

        stateFile.setText(lua);
    }
}
