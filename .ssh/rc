#!/bin/sh
# Replaces sshd's default xauth handling; safe only while nothing forwards X11.

[ "$(uname)" = Darwin ] && exit 0

case "$SSH_AUTH_SOCK" in
  ""|"$HOME/.ssh/agent.sock") exit 0 ;;
esac

[ -S "$SSH_AUTH_SOCK" ] || exit 0

# Exit 0 means reachable *and* holding identities; 1 is reachable but empty.
SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1 || exit 0

tmp="$HOME/.ssh/agent.sock.$$"
ln -sfn "$SSH_AUTH_SOCK" "$tmp" 2>/dev/null || exit 0
mv -Tf "$tmp" "$HOME/.ssh/agent.sock" 2>/dev/null || rm -f "$tmp"

exit 0
