#!/bin/sh
# Replaces sshd's default xauth handling; safe only while nothing forwards X11.
# sshd runs this via the login shell, so ~/.zshenv has already rewritten
# SSH_AUTH_SOCK to the symlink by now. Find the real socket rather than trust it.

[ "$(uname)" = Darwin ] && exit 0

sock=""
case "$SSH_AUTH_SOCK" in
  ""|"$HOME/.ssh/agent.sock") ;;
  *) [ -S "$SSH_AUTH_SOCK" ] && sock="$SSH_AUTH_SOCK" ;;
esac

if [ -z "$sock" ]; then
  for c in $(ls -t "$HOME"/.ssh/agent/*.sshd.* 2>/dev/null); do
    [ -S "$c" ] || continue
    if SSH_AUTH_SOCK="$c" ssh-add -l >/dev/null 2>&1; then sock="$c"; break; fi
  done
fi

[ -n "$sock" ] || exit 0

# Exit 0 means reachable *and* holding identities; 1 is reachable but empty.
SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1 || exit 0

[ "$(readlink "$HOME/.ssh/agent.sock" 2>/dev/null)" = "$sock" ] && exit 0

tmp="$HOME/.ssh/agent.sock.$$"
ln -sfn "$sock" "$tmp" 2>/dev/null || exit 0
mv -Tf "$tmp" "$HOME/.ssh/agent.sock" 2>/dev/null || rm -f "$tmp"

exit 0
